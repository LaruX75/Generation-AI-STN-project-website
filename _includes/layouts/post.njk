---
layout: layouts/base.njk
---
{% set _lang = lang if lang else "fi" %}
{% set _searchBase = "/en/search/" if _lang == "en" else ("/sv/sok/" if _lang == "sv" else "/haku/") %}
{% set _postCollection = collections.posts_en if _lang == "en" else (collections.posts_sv if _lang == "sv" else collections.posts_fi) %}
{% set _relPosts = _postCollection | relatedPosts(page.url, tags) %}
{% set _relatedCategoryAllowlist = [
  "Mediassa", "Tapahtumat", "Toiminta", "Tutkimus",
  "In the media", "Events", "Project activities", "Research",
  "I media", "Evenemang", "Projektaktiviteter", "Forskning"
] %}
{% set _showRelatedContent = false %}
{% for _category in categories or [] %}
  {% if _category in _relatedCategoryAllowlist %}
    {% set _showRelatedContent = true %}
  {% endif %}
{% endfor %}

{% set _catUrls = {
  "Mediassa": "/ajankohtaista/#tab-media",
  "Tapahtumat": "/ajankohtaista/#tab-tapahtumat",
  "Toiminta": "/ajankohtaista/#tab-toiminta",
  "Tutkimus": "/tutkijalle/",
  "In the media": "/en/current-affairs/#tab-media",
  "Events": "/en/current-affairs/#tab-tapahtumat",
  "Project activities": "/en/activities/",
  "Research": "/en/research/",
  "I media": "/sv/aktuellt/#tab-media",
  "Evenemang": "/sv/aktuellt/#tab-tapahtumat",
  "Projektaktiviteter": "/sv/verksamhet/",
  "Forskning": "/sv/forskning/"
} %}

{% set _homeLabel = "Etusivu" %}
{% set _homeUrl = "/" %}
{% set _sectionLabel = "Ajankohtaista" %}
{% set _sectionUrl = "/ajankohtaista/" %}
{% if _lang == "en" %}
  {% set _homeLabel = "Home" %}
  {% set _homeUrl = "/en/" %}
  {% set _sectionLabel = "Current affairs" %}
  {% set _sectionUrl = "/en/current-affairs/" %}
{% elif _lang == "sv" %}
  {% set _homeLabel = "Hem" %}
  {% set _homeUrl = "/sv/" %}
  {% set _sectionLabel = "Aktuellt" %}
  {% set _sectionUrl = "/sv/aktuellt/" %}
{% endif %}

<main class="post">
  <div class="post-inner">
    <nav class="post-breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="{{ _homeUrl }}">{{ _homeLabel }}</a></li>
        <li><a href="{{ _sectionUrl }}">{{ _sectionLabel }}</a></li>
        {% if mainCategory %}<li><a href="{{ _catUrls[mainCategory] if _catUrls[mainCategory] else (_searchBase + '?q=' + (mainCategory | urlencode)) }}">{{ mainCategory }}</a></li>{% endif %}
        <li aria-current="page">{{ title | truncate(60) }}</li>
      </ol>
    </nav>

    <header class="post-header">
      {% if categories and categories.length %}
      <div class="post-categories">
        {% for c in categories %}
        {% set _href = _catUrls[c] if _catUrls[c] else (_searchBase + "?q=" + (c | urlencode)) %}
        <a class="post-category" href="{{ _href }}">{{ c }}</a>
        {% endfor %}
      </div>
      {% endif %}
      <h1 class="post-title">{{ title }}</h1>
      {% if excerpt %}<p class="post-excerpt">{{ excerpt }}</p>{% endif %}
      {% if date %}<time class="post-date" datetime="{{ date }}">{{ date | date("d.m.Y") }}</time>{% endif %}
      {% if featuredImage %}<img class="post-featured-image" src="{{ featuredImage }}" alt="{{ title }}">{% endif %}
    </header>

    <div class="post-content">{{ content | safe }}</div>

    {% if tags and tags.length %}
    <footer class="post-footer">
      <div class="post-tags">
        {% for tag in tags %}
        <a class="post-tag" href="{{ _searchBase }}?q={{ tag | urlencode }}">{{ tag }}</a>
        {% endfor %}
      </div>
    </footer>
    {% endif %}

    {% set _editEntry = page.inputPath | replace("./content/posts/" + _lang + "/", "") | replace(".md", "") | replace(".njk", "") %}
    <a class="post-edit-link" href="/admin/#/collections/posts/entries/{{ _editEntry }}" target="_blank" rel="noopener" aria-label="Muokkaa artikkelia Sveltia-editorissa" hidden>
      <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      {% if _lang == "en" %}Edit{% elif _lang == "sv" %}Redigera{% else %}Muokkaa{% endif %}
    </a>
    <script>if(Object.keys(localStorage).some(k=>k.startsWith('sveltia-cms'))){document.currentScript.previousElementSibling.removeAttribute('hidden');}</script>

    {% if _showRelatedContent %}
      {% include "partials/related-content.njk" %}
    {% endif %}
  </div>
</main>
