<head>
  <script>!function(){try{var s=JSON.parse(localStorage.getItem('genai_a11y')||'{}'),h=document.documentElement;if(s.dyslexia)h.classList.add('a11y-dyslexia');if(s.contrast)h.classList.add('a11y-contrast');if(s.spacing)h.classList.add('a11y-spacing');if(s.bg)h.dataset.a11yBg=s.bg;if(s.fontSize)h.style.fontSize=(100+s.fontSize*12.5)+'%';}catch(e){}}();</script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://assets.mailerlite.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://api.web3forms.com https://assets.mailerlite.com https://api.github.com https://cloudflareinsights.com; font-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com;">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta http-equiv="X-Content-Type-Options" content="nosniff">
  <meta http-equiv="Permissions-Policy" content="geolocation=(), microphone=(), camera=(), payment=(), usb=()">
  <title>{% if seoTitle %}{{ seoTitle }}{% elif title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
  {% set _desc = [seoDescription, ogDescription, excerpt] | metaDescription(content, 170) %}
  {% if _desc %}<meta name="description" content="{{ _desc }}">{% endif %}
  {% set _canonical = canonical if canonical else (site.url + page.url) %}
  {% set localeUrlOverrides = {
    "/": { "fi": "/", "en": "/en/", "sv": "/sv/" },
    "/en/": { "fi": "/", "en": "/en/", "sv": "/sv/" },
    "/en/home/": { "fi": "/", "en": "/en/", "sv": "/sv/" },
    "/en/welcome-to-the-generation-ai-project-website/": { "fi": "/", "en": "/en/", "sv": "/sv/" },
    "/sv/": { "fi": "/", "en": "/en/", "sv": "/sv/" },
    "/sv/startsida/": { "fi": "/", "en": "/en/", "sv": "/sv/" },
    "/sv/valkommen-till-generation-ai-projektets-webbplats/": { "fi": "/", "en": "/en/", "sv": "/sv/" },
    "/ajankohtaista/": { "fi": "/ajankohtaista/", "en": "/en/current-affairs/", "sv": "/sv/aktuellt/" },
    "/materiaalit/": { "fi": "/materiaalit/", "en": "/en/materials/", "sv": "/sv/material/" },
    "/hankkeen-toiminta/": { "fi": "/hankkeen-toiminta/", "en": "/en/activities/", "sv": "/sv/verksamhet/" },
    "/en/activities/": { "fi": "/hankkeen-toiminta/", "en": "/en/activities/", "sv": "/sv/verksamhet/" },
    "/en/what-we-do/": { "fi": "/hankkeen-toiminta/", "en": "/en/activities/", "sv": "/sv/verksamhet/" },
    "/sv/atgard/": { "fi": "/hankkeen-toiminta/", "en": "/en/activities/", "sv": "/sv/verksamhet/" },
    "/sv/verksamhet/": { "fi": "/hankkeen-toiminta/", "en": "/en/activities/", "sv": "/sv/verksamhet/" },
    "/konsortio/": { "fi": "/konsortio/", "en": "/en/consortium/", "sv": "/sv/konsortium/" },
    "/ollaan-yhteydessa/": { "fi": "/ollaan-yhteydessa/", "en": "/en/get-in-touch/", "sv": "/sv/kontakta-oss/" },
    "/opettajalle/": { "fi": "/opettajalle/", "en": "/en/for-teachers/", "sv": "/sv/for-larare/" },
    "/tutkijalle/": { "fi": "/tutkijalle/", "en": "/en/research/", "sv": "/sv/forskning/" },
    "/yleisolle/": { "fi": "/yleisolle/", "en": "/en/for-everyone/", "sv": "/sv/for-allmanheten/" },
    "/haku/": { "fi": "/haku/", "en": "/en/search/", "sv": "/sv/sok/" },
    "/en/search/": { "fi": "/haku/", "en": "/en/search/", "sv": "/sv/sok/" },
    "/sv/sok/": { "fi": "/haku/", "en": "/en/search/", "sv": "/sv/sok/" }
  } %}
  {% set _localeLinks = translations.byUrl[page.url] if translations and translations.byUrl and page and page.url else {} %}
  {% set _overrideLinks = localeUrlOverrides[page.url] if page and page.url and localeUrlOverrides[page.url] else null %}
  <link rel="canonical" href="{{ _canonical }}">
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">
  {% if _overrideLinks %}
    {% for locale, url in _overrideLinks %}
      {% if url %}
        <link rel="alternate" hreflang="{{ locale }}" href="{{ site.url + url }}">
      {% endif %}
    {% endfor %}
    {% if _overrideLinks.fi %}
      <link rel="alternate" hreflang="x-default" href="{{ site.url + _overrideLinks.fi }}">
    {% endif %}
  {% elif _localeLinks %}
    {% for locale, item in _localeLinks %}
      {% if item and item.url %}
        <link rel="alternate" hreflang="{{ locale }}" href="{{ site.url + item.url }}">
      {% endif %}
    {% endfor %}
    {% if _localeLinks.fi and _localeLinks.fi.url %}
      <link rel="alternate" hreflang="x-default" href="{{ site.url + _localeLinks.fi.url }}">
    {% endif %}
  {% endif %}
  {# ── Favicon ──────────────────────────────────────────────────────────── #}
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
  {# ── Robots / indexing ────────────────────────────────────────────────── #}
  {% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}
  {% if site.googleSiteVerification %}<meta name="google-site-verification" content="{{ site.googleSiteVerification }}">{% endif %}
  {# ── Open Graph ───────────────────────────────────────────────────────── #}
  {% set _ogType = "article" if sourceType == "posts" else "website" %}
  {% set _ogTitle = ogTitle if ogTitle else (seoTitle if seoTitle else title) %}
  {% set _ogDesc = ogDescription if ogDescription else _desc %}
  {% set _ogLocale = "fi_FI" %}
  {% if lang == "en" %}{% set _ogLocale = "en_GB" %}{% elif lang == "sv" %}{% set _ogLocale = "sv_SE" %}{% endif %}
  {% set _pageLang = lang if lang else (site.defaultLocale if site and site.defaultLocale else "fi") %}
  {% set _homePath = "/" %}
  {% set _homeLabel = "Etusivu" %}
  {% set _searchPath = "/haku/" %}
  {% if _pageLang == "en" %}
    {% set _homePath = "/en/" %}
    {% set _homeLabel = "Home" %}
    {% set _searchPath = "/en/search/" %}
  {% elif _pageLang == "sv" %}
    {% set _homePath = "/sv/" %}
    {% set _homeLabel = "Startsida" %}
    {% set _searchPath = "/sv/sok/" %}
  {% endif %}
  {% set _repoPrefix = site.repoPrefix if site.repoPrefix and site.repoPrefix != "/" else "" %}
  {% set _ogImageSource = (ogImage if ogImage else (featuredImage if featuredImage else (heroImage if heroImage else (heroBgImage if heroBgImage else (site.defaultHeroImage if site and site.defaultHeroImage else site.logo))))) | normalizeSiteMediaUrl %}
  {% set _ogImage = _ogImageSource %}
  {% if _ogImageSource and (_ogImageSource[0] == "/") %}
    {% set _ogImage = site.url + _repoPrefix + _ogImageSource %}
  {% endif %}
  {% set _heroPreload = null %}
  {% if pageHero or heroImage or heroBgImage or featuredImage %}
    {% set _heroCandidate = site.defaultHeroImage if pageHero and site and site.defaultHeroImage else (heroImage if heroImage else (heroBgImage if heroBgImage else (featuredImage if featuredImage else null))) %}
    {% if _heroCandidate %}
      {% if _heroCandidate[0] == "/" %}
        {% set _heroPreload = _repoPrefix + _heroCandidate %}
      {% else %}
        {% set _heroPreload = _heroCandidate %}
      {% endif %}
    {% endif %}
  {% endif %}
  <meta property="og:type" content="{{ _ogType }}">
  <meta property="og:url" content="{{ _canonical }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ _ogLocale }}">
  <meta property="og:title" content="{{ _ogTitle }}">
  {% if _ogDesc %}<meta property="og:description" content="{{ _ogDesc }}">{% endif %}
  <meta property="og:image" content="{{ _ogImage }}">
  <meta property="og:image:alt" content="{{ _ogTitle }}">
  {% if _ogType == "article" %}
  <meta property="article:published_time" content="{{ date | rssDate if date else "" }}">
  {% if updated %}<meta property="article:modified_time" content="{{ updated | rssDate }}">{% endif %}
  {% endif %}
  {# ── Twitter / X Card ────────────────────────────────────────────────── #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ _ogTitle }}">
  {% if _ogDesc %}<meta name="twitter:description" content="{{ _ogDesc }}">{% endif %}
  <meta name="twitter:image" content="{{ _ogImage }}">
  {# ── RSS feeds ────────────────────────────────────────────────────────── #}
  {% set _feedLocale = lang if lang else (site.defaultLocale if site and site.defaultLocale else "fi") %}
  {% if _feedLocale == "en" %}
    <link rel="alternate" type="application/rss+xml" title="{{ site.name }} (EN)" href="{{ site.url }}/en/feed.xml">
  {% elif _feedLocale == "sv" %}
    <link rel="alternate" type="application/rss+xml" title="{{ site.name }} (SV)" href="{{ site.url }}/sv/feed.xml">
  {% else %}
    <link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="{{ site.url }}/feed.xml">
  {% endif %}
  {% if _heroPreload %}
    <link rel="preload" as="image" href="{{ _heroPreload }}" fetchpriority="high">
  {% endif %}
  {% set _schemaGraph = [
    {
      "@type": "Organization",
      "@id": site.url + "/#organization",
      "name": site.name,
      "url": site.url,
      "logo": {
        "@type": "ImageObject",
        "url": site.url + site.logo
      }
    },
    {
      "@type": "WebSite",
      "@id": site.url + "/#website",
      "url": site.url,
      "name": site.name,
      "inLanguage": _pageLang,
      "publisher": { "@id": site.url + "/#organization" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": site.url + _searchPath + "?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  ] %}
  {% set _breadcrumbItems = [
    {
      "@type": "ListItem",
      "position": 1,
      "name": _homeLabel,
      "item": site.url + _homePath
    }
  ] %}
  {% if page.url != _homePath %}
    {% set _breadcrumbItems = _breadcrumbItems.concat([
      {
        "@type": "ListItem",
        "position": 2,
        "name": title if title else _ogTitle,
        "item": _canonical
      }
    ]) %}
  {% endif %}
  {% set _schemaGraph = _schemaGraph.concat([
    {
      "@type": "BreadcrumbList",
      "@id": _canonical + "#breadcrumb",
      "itemListElement": _breadcrumbItems
    },
    {
      "@type": "WebPage",
      "@id": _canonical + "#webpage",
      "url": _canonical,
      "name": _ogTitle,
      "description": _desc,
      "inLanguage": _pageLang,
      "isPartOf": { "@id": site.url + "/#website" },
      "breadcrumb": { "@id": _canonical + "#breadcrumb" }
    }
  ]) %}
  {% if sourceType == "posts" %}
    {% set _articleSchema = {
      "@type": "Article",
      "@id": _canonical + "#article",
      "headline": _ogTitle,
      "description": _desc,
      "mainEntityOfPage": { "@id": _canonical + "#webpage" },
      "url": _canonical,
      "datePublished": date | rssDate if date else "",
      "dateModified": updated | rssDate if updated else (date | rssDate if date else ""),
      "inLanguage": _pageLang,
      "image": [_ogImage],
      "publisher": { "@id": site.url + "/#organization" }
    } %}
    {% set _schemaGraph = _schemaGraph.concat([_articleSchema]) %}
  {% endif %}
  <script type="application/ld+json">{{ { "@context": "https://schema.org", "@graph": _schemaGraph } | jsonLd | safe }}</script>
  <link rel="stylesheet" href="/styles/gridjs-mermaid.css">
  <style>{% inlineCss "styles/modules/_base.css" %}</style>
  <link rel="stylesheet" href="/styles/theme.css">
  <link rel="stylesheet" href="/styles/cookieconsent.css">
</head>
