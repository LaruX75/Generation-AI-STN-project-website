{# Tab navigation for Ajankohtaista / Current affairs / Aktuellt sub-pages.
   Caller sets `activeTab`: "uutiset" | "tapahtumat" | "toiminta" | "julkaisut"
   Reads global `lang`. #}

{% if lang == "en" %}
  {% set _tabs = [
    { k: "uutiset",    href: "/en/current-affairs/",              label: "Media and news" },
    { k: "tapahtumat", href: "/en/current-affairs/events/",       label: "Events and activities" },
    { k: "toiminta",   href: "/en/current-affairs/activities/",   label: "Scientific activities" },
    { k: "julkaisut",  href: "/en/current-affairs/publications/", label: "Publications" }
  ] %}
  {% set _navLabel = "Current affairs sections" %}
{% elif lang == "sv" %}
  {% set _tabs = [
    { k: "uutiset",    href: "/sv/aktuellt/",                  label: "Media och nyheter" },
    { k: "tapahtumat", href: "/sv/aktuellt/evenemang/",        label: "Evenemang och verksamhet" },
    { k: "toiminta",   href: "/sv/aktuellt/verksamhet/",       label: "Vetenskaplig verksamhet" },
    { k: "julkaisut",  href: "/sv/aktuellt/publikationer/",    label: "Publikationer" }
  ] %}
  {% set _navLabel = "Aktuellt-avsnitt" %}
{% else %}
  {% set _tabs = [
    { k: "uutiset",    href: "/ajankohtaista/",            label: "Media ja uutiset" },
    { k: "tapahtumat", href: "/ajankohtaista/tapahtumat/", label: "Tapahtumat ja toiminta" },
    { k: "toiminta",   href: "/ajankohtaista/toiminta/",   label: "Tieteellinen toiminta" },
    { k: "julkaisut",  href: "/ajankohtaista/julkaisut/",  label: "Julkaisut" }
  ] %}
  {% set _navLabel = "Ajankohtaista-osiot" %}
{% endif %}

<ul class="kt-tabs-title-list" aria-label="{{ _navLabel }}">
  {% for _t in _tabs %}
    {% set _active = _t.k == activeTab %}
    <li class="kt-title-item{% if _active %} kt-tab-title-active{% else %} kt-tab-title-inactive{% endif %}">
      <a href="{{ _t.href }}" class="kt-tab-title"{% if _active %} aria-current="page"{% endif %}>
        <span class="kt-title-text">{{ _t.label }}</span>
      </a>
    </li>
  {% endfor %}
</ul>
