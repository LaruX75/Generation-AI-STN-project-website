{% set allItems = scientificPublications.tableItems or [] %}
{% set scipubAuthorParam = "scipub-author" %}
{% set scipubAuthorBaseUrl = page.url or "/" %}
{% set scipubAuthorHash = scipubTabHash or "" %}

{% if lang == "en" %}
  {% set lbl = {
    "heading": "Scientific publications",
    "search": "Search publications", "placeholder": "Search by title or author…",
    "catLabel": "Filter by publication type", "catAll": "All types",
    "catA": "A — Peer-reviewed articles", "catBE": "B/E — Books and edited volumes", "catOther": "Other",
    "yrLabel": "Filter by year", "yrAll": "All years",
    "aria": "Scientific publications", "ariaPag": "Result page",
    "colAuthors": "Authors", "colYear": "Year", "colTitle": "Title", "colVenue": "Publication", "colLink": "Link", "colCode": "Code",
    "open": "Open", "newTab": "(opens in new tab)", "na": "—", "empty": "No results.",
    "prev": "← Previous", "next": "Next →",
    "jsPage": "Page", "jsSep": "/", "jsResults": "results",
    "citeOpen": "Export citation", "citeTitle": "Export citation", "citeFormat": "Citation format",
    "citeCopy": "Copy", "citeDownload": "Download", "citePreview": "Preview", "citeClose": "Close",
    "citeBibtex": "BibTeX (.bib)", "citeApa": "APA", "citeMla": "MLA", "citeChicago": "Chicago",
    "citeCopied": "Copied!"
  } %}
{% elif lang == "sv" %}
  {% set lbl = {
    "heading": "Vetenskapliga publikationer",
    "search": "Sök publikationer", "placeholder": "Sök på rubrik eller författare…",
    "catLabel": "Filtrera efter publikationstyp", "catAll": "Alla typer",
    "catA": "A — Referentgranskade artiklar", "catBE": "B/E — Böcker och antologier", "catOther": "Övriga",
    "yrLabel": "Filtrera efter år", "yrAll": "Alla år",
    "aria": "Vetenskapliga publikationer", "ariaPag": "Resultatsida",
    "colAuthors": "Författare", "colYear": "År", "colTitle": "Titel", "colVenue": "Publikation", "colLink": "Länk", "colCode": "Kod",
    "open": "Öppna", "newTab": "(öppnas i ny flik)", "na": "—", "empty": "Inga resultat.",
    "prev": "← Föregående", "next": "Nästa →",
    "jsPage": "Sida", "jsSep": "/", "jsResults": "resultat",
    "citeOpen": "Exportera referens", "citeTitle": "Exportera referens", "citeFormat": "Referensformat",
    "citeCopy": "Kopiera", "citeDownload": "Ladda ner", "citePreview": "Förhandsvisning", "citeClose": "Stäng",
    "citeBibtex": "BibTeX (.bib)", "citeApa": "APA", "citeMla": "MLA", "citeChicago": "Chicago",
    "citeCopied": "Kopierad!"
  } %}
{% else %}
  {% set lbl = {
    "heading": "Tieteelliset julkaisut",
    "search": "Hae julkaisuista", "placeholder": "Hae otsikolla tai tekijällä…",
    "catLabel": "Suodata julkaisutyypin mukaan", "catAll": "Kaikki julkaisutyypit",
    "catA": "A — Vertaisarvioidut artikkelit", "catBE": "B/E — Kirjat ja kokoomateokset", "catOther": "Muut",
    "yrLabel": "Suodata vuoden mukaan", "yrAll": "Kaikki vuodet",
    "aria": "Tieteelliset julkaisut", "ariaPag": "Tulossivu",
    "colAuthors": "Tekijät", "colYear": "Vuosi", "colTitle": "Otsikko", "colVenue": "Julkaisun nimi", "colLink": "Linkki", "colCode": "Koodi",
    "open": "Avaa", "newTab": "(avautuu uudessa välilehdessä)", "na": "—", "empty": "Ei tuloksia.",
    "prev": "← Edellinen", "next": "Seuraava →",
    "jsPage": "Sivu", "jsSep": "/", "jsResults": "tulosta",
    "citeOpen": "Vie viite", "citeTitle": "Vie lähdeviite", "citeFormat": "Viittausmuoto",
    "citeCopy": "Kopioi", "citeDownload": "Lataa", "citePreview": "Esikatselu", "citeClose": "Sulje",
    "citeBibtex": "BibTeX (.bib)", "citeApa": "APA", "citeMla": "MLA", "citeChicago": "Chicago",
    "citeCopied": "Kopioitu!"
  } %}
{% endif %}

<section class="media-table-section" id="scipub-table-section" data-grid-enhance data-grid-page-size="25">

  <div class="media-table-header">
    <h2 class="media-table-heading">{{ lbl.heading }}</h2>
    <div class="media-table-controls">
      <div class="media-table-search-wrap">
        <label for="scipub-search" class="sr-only">{{ lbl.search }}</label>
        <input type="search" id="scipub-search" class="media-table-search" placeholder="{{ lbl.placeholder }}" autocomplete="off" data-grid-search>
      </div>
      <div class="media-table-filters">
        <label for="scipub-filter-cat" class="sr-only">{{ lbl.catLabel }}</label>
        <select id="scipub-filter-cat" class="media-table-filter" data-grid-filter="category">
          <option value="">{{ lbl.catAll }}</option>
          <option value="a">{{ lbl.catA }}</option>
          <option value="be">{{ lbl.catBE }}</option>
          <option value="other">{{ lbl.catOther }}</option>
        </select>
        <label for="scipub-filter-year" class="sr-only">{{ lbl.yrLabel }}</label>
        <select id="scipub-filter-year" class="media-table-filter" data-grid-filter="year" data-grid-populate-options="year">
          <option value="">{{ lbl.yrAll }}</option>
        </select>
      </div>
      <p class="media-table-count" id="scipub-count" aria-live="polite" data-grid-count></p>
    </div>
  </div>

  <div class="media-table-wrap" role="region" aria-label="{{ lbl.aria }}">
    <table class="media-table" id="scipub-table" data-grid-source>
      <thead>
        <tr>
          <th scope="col" class="media-table-col--authors media-table-col--mobile-hide">{{ lbl.colAuthors }}</th>
          <th scope="col" class="media-table-col--date">{{ lbl.colYear }}</th>
          <th scope="col" class="media-table-col--title">{{ lbl.colTitle }}</th>
          <th scope="col" class="media-table-col--venue media-table-col--mobile-hide">{{ lbl.colVenue }}</th>
          <th scope="col" class="media-table-col--link media-table-col--mobile-hide">{{ lbl.colLink }}</th>
          <th scope="col" class="media-table-col--source media-table-col--mobile-hide">{{ lbl.colCode }}</th>
        </tr>
      </thead>
      {#
        Makro välttää rivirakenteen toistoa: 2024+ rivit renderöidään suoraan
        <tbody>:hin, vanhemmat <template data-grid-defer>:iin. JS siirtää
        template-sisällön <tbody>:hin ennen GridJS:n alustusta, joten GridJS
        näkee kaikki rivit — mutta selain ei renderöi template-sisältöä
        ennen JS:ää, mikä keventää alkuperäistä DOM-painoa merkittävästi.
      #}
      {% macro pubRow(item) %}
          <tr class="media-table-row"
            data-year="{{ item.year | default('') }}"
            data-category="{% if item.code and item.code | truncate(1, true, '') == 'A' %}a{% elif item.code and (item.code | truncate(1, true, '') == 'B' or item.code | truncate(1, true, '') == 'E') %}be{% else %}other{% endif %}"
            data-search="{{ item.searchText | lower | default('') }} {{ item.authorsText | lower | default('') }}">
            <td class="media-table-col--authors media-table-col--mobile-hide">
              {% if item.authors and item.authors.length %}
                {% for author in item.authors %}<a class="scipub-author-link" href="{{ scipubAuthorBaseUrl }}?{{ scipubAuthorParam }}={{ author | urlencode }}{{ scipubAuthorHash }}">{{ author }}</a>{% if not loop.last %}; {% endif %}{% endfor %}
              {% else %}
                {{ item.authorsText | default('—') }}
              {% endif %}
            </td>
            <td class="media-table-col--date">{{ item.year | default('—') }}</td>
            <td class="media-table-col--title">
              {% if item.link %}
                <a href="{{ item.link }}" class="media-table-title-link" target="_blank" rel="noopener noreferrer">{{ item.title | default('—') }}<span class="sr-only"> {{ lbl.newTab }}</span></a>
              {% else %}
                {{ item.title | default('—') }}
              {% endif %}
              {% if item.authorsText %}<small class="scipub-mobile-authors">{{ item.authorsText }}</small>{% endif %}
              <div class="scipub-inline-actions">
                <button
                  class="scipub-cite-btn"
                  type="button"
                  data-citation-id="{{ item.id }}"
                >{{ lbl.citeOpen }}</button>
              </div>
            </td>
            <td class="media-table-col--venue media-table-col--mobile-hide">{{ item.venue | default('—') }}</td>
            <td class="media-table-col--link media-table-col--mobile-hide">
              {% if item.link %}
                <a href="{{ item.link }}" class="media-table-link" aria-hidden="true" tabindex="-1" target="_blank" rel="noopener noreferrer">{{ item.linkLabel | default(lbl.open) }}&nbsp;<span aria-hidden="true">↗</span></a>
              {% else %}
                <span class="media-table-na">{{ lbl.na }}</span>
              {% endif %}
            </td>
            <td class="media-table-col--source media-table-col--mobile-hide">
              <span class="scipub-badge">{{ item.code | default('—') }}</span>
            </td>
          </tr>
      {% endmacro %}
      <tbody id="scipub-table-body">
        {% for item in allItems %}
          {% if item.year and item.year >= 2024 %}{{ pubRow(item) }}{% endif %}
        {% endfor %}
      </tbody>
    </table>
    {# Vanhemmat rivit (< 2024) siirretään JS:ssä tbody:hin ennen GridJS-alustusta #}
    <template data-grid-defer="scipub-table-body">
      {% for item in allItems %}
        {% if not (item.year and item.year >= 2024) %}{{ pubRow(item) }}{% endif %}
      {% endfor %}
    </template>
    <p class="media-table-empty" id="scipub-empty" hidden>{{ lbl.empty }}</p>
  </div>

  <nav class="media-table-pagination" id="scipub-pagination" aria-label="{{ lbl.ariaPag }}">
    <button class="media-table-page-btn" id="scipub-prev" aria-label="{{ lbl.prev }}">{{ lbl.prev }}</button>
    <span class="media-table-page-info" id="scipub-page-info" aria-live="polite"></span>
    <button class="media-table-page-btn" id="scipub-next" aria-label="{{ lbl.next }}">{{ lbl.next }}</button>
  </nav>

</section>

<div
  id="scipub-citation-modal"
  class="scipub-citation-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="scipub-citation-title"
  hidden
>
  <div class="scipub-citation-modal__backdrop" data-citation-close="backdrop" aria-hidden="true"></div>
  <div class="scipub-citation-modal__box">
    <div class="scipub-citation-modal__header">
      <h3 id="scipub-citation-title" class="scipub-citation-modal__title">{{ lbl.citeTitle }}</h3>
      <button class="scipub-citation-modal__close" type="button" data-citation-close="button" aria-label="{{ lbl.citeClose }}">{{ lbl.citeClose }}</button>
    </div>
    <div class="scipub-citation-modal__content">
      <div class="scipub-citation-modal__toolbar">
        <label class="scipub-citation-modal__field">
          <span class="scipub-citation-modal__label">{{ lbl.citeFormat }}</span>
          <select id="scipub-citation-format" class="scipub-citation-modal__select">
            <option value="bibtex">{{ lbl.citeBibtex }}</option>
            <option value="apa">{{ lbl.citeApa }}</option>
            <option value="mla">{{ lbl.citeMla }}</option>
            <option value="chicago">{{ lbl.citeChicago }}</option>
          </select>
        </label>
        <div class="scipub-citation-modal__actions">
          <button id="scipub-citation-copy" class="scipub-citation-modal__action" type="button">{{ lbl.citeCopy }}</button>
          <button id="scipub-citation-download" class="scipub-citation-modal__action" type="button">{{ lbl.citeDownload }}</button>
        </div>
      </div>
      <label class="scipub-citation-modal__preview" for="scipub-citation-preview">
        <span class="scipub-citation-modal__label">{{ lbl.citePreview }}</span>
        <textarea id="scipub-citation-preview" class="scipub-citation-modal__textarea" readonly></textarea>
      </label>
    </div>
  </div>
</div>

<script id="scipub-citation-data" type="application/json">
{
{% for item in allItems %}
  {{ item.id | dump | safe }}: {
    "title": {{ item.title | dump | safe }},
    "fileName": {{ item.citationFileName | dump | safe }},
    "formats": {{ item.citationFormats | dump | safe }}
  }{% if not loop.last %},{% endif %}
{% endfor %}
}
</script>

<script>
(function () {
  var citationDataEl = document.getElementById("scipub-citation-data");
  var citationData = {};
  var modal = document.getElementById("scipub-citation-modal");
  var formatSelect = document.getElementById("scipub-citation-format");
  var previewEl = document.getElementById("scipub-citation-preview");
  var copyBtn = document.getElementById("scipub-citation-copy");
  var downloadBtn = document.getElementById("scipub-citation-download");
  var titleEl = document.getElementById("scipub-citation-title");
  var lastTrigger = null;
  var activeCitation = null;

  if (citationDataEl) {
    try {
      citationData = JSON.parse(citationDataEl.textContent || "{}");
    } catch (error) {
      citationData = {};
    }
  }

  function applyAuthorFilterFromUrl() {
    var section = document.getElementById("scipub-table-section");
    if (!section) return;
    var params = new URLSearchParams(window.location.search);
    var author = params.get("{{ scipubAuthorParam }}");
    if (!author) return;
    var search = section.querySelector("[data-grid-search]");
    if (!search) return;
    if (search.value === author) return;
    search.value = author;
    search.dispatchEvent(new Event("input", { bubbles: true }));
  }

  function getSelectedFormat() {
    return formatSelect ? formatSelect.value : "bibtex";
  }

  function getCitationText() {
    if (!activeCitation || !activeCitation.formats) return "";
    return activeCitation.formats[getSelectedFormat()] || "";
  }

  function updateCitationPreview() {
    if (!previewEl) return;
    previewEl.value = getCitationText();
  }

  function citationExtension(format) {
    return format === "bibtex" ? "bib" : "txt";
  }

  function openCitationModal(trigger) {
    var citationId = trigger && trigger.getAttribute("data-citation-id");
    if (!citationId || !citationData[citationId] || !modal) return;
    activeCitation = citationData[citationId];
    lastTrigger = trigger;
    if (titleEl && activeCitation.title) {
      titleEl.textContent = "{{ lbl.citeTitle }}" + ": " + activeCitation.title;
    }
    if (formatSelect) formatSelect.value = "bibtex";
    updateCitationPreview();
    modal.hidden = false;
    document.body.classList.add("search-modal-open");
    if (formatSelect) formatSelect.focus();
  }

  function closeCitationModal() {
    if (!modal || modal.hidden) return;
    modal.hidden = true;
    document.body.classList.remove("search-modal-open");
    activeCitation = null;
    if (titleEl) titleEl.textContent = "{{ lbl.citeTitle }}";
    if (lastTrigger) lastTrigger.focus();
  }

  function fallbackCopy(text) {
    if (!previewEl) return false;
    previewEl.focus();
    previewEl.select();
    try {
      return document.execCommand("copy");
    } catch (error) {
      return false;
    }
  }

  async function copyCitation() {
    var text = getCitationText();
    if (!text || !copyBtn) return;
    var copied = false;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      try {
        await navigator.clipboard.writeText(text);
        copied = true;
      } catch (error) {
        copied = fallbackCopy(text);
      }
    } else {
      copied = fallbackCopy(text);
    }
    if (!copied) return;
    var original = copyBtn.textContent;
    copyBtn.textContent = "{{ lbl.citeCopied }}";
    window.setTimeout(function () {
      copyBtn.textContent = original;
    }, 1600);
  }

  function downloadCitation() {
    var text = getCitationText();
    if (!text || !activeCitation) return;
    var format = getSelectedFormat();
    var fileName = (activeCitation.fileName || "publication") + "." + citationExtension(format);
    var blob = new Blob([text], { type: "text/plain;charset=utf-8" });
    var url = URL.createObjectURL(blob);
    var link = document.createElement("a");
    link.href = url;
    link.download = fileName;
    document.body.appendChild(link);
    link.click();
    link.remove();
    window.setTimeout(function () {
      URL.revokeObjectURL(url);
    }, 0);
  }

  document.addEventListener("click", function (e) {
    var citeBtn = e.target.closest(".scipub-cite-btn");
    if (citeBtn) {
      openCitationModal(citeBtn);
      return;
    }

    if (e.target.closest("[data-citation-close]")) {
      closeCitationModal();
    }
  });

  if (formatSelect) {
    formatSelect.addEventListener("change", updateCitationPreview);
  }

  if (copyBtn) {
    copyBtn.addEventListener("click", function () {
      copyCitation();
    });
  }

  if (downloadBtn) {
    downloadBtn.addEventListener("click", downloadCitation);
  }

  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && modal && !modal.hidden) {
      e.preventDefault();
      closeCitationModal();
    }
  });

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", applyAuthorFilterFromUrl);
    return;
  }

  applyAuthorFilterFromUrl();
}());
</script>
