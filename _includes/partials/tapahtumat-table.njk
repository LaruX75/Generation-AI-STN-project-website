{% else %}
  {% set lbl = {
    "heading": "Tapahtumat ja toiminta", "search": "Hae tapahtumista", "placeholder": "Hae otsikolla…",
    "typeLabel": "Suodata tyypeittäin", "typeAll": "Kaikki tyypit",
    "typeConf": "Konferenssit ja seminaarit", "typeConfVal": "konferenssit ja seminaarit",
    "typeWeb": "Webinaari", "typeWebVal": "webinaari",
    "typeWS": "Työpaja", "typeWSVal": "työpaja",
    "typeEvent": "Tapahtuma", "typeEventVal": "tapahtuma",
    "typeActivity": "Hankkeen toiminta", "typeActivityVal": "toiminta-stakeholder",
    "badgeConf": "Konferenssi", "badgeWeb": "Webinaari", "badgeWS": "Työpaja", "badgeEvent": "Tapahtuma",
    "badgeActivity": "Hankkeen toiminta",
    "catConf": "Konferenssit ja seminaarit", "catWeb": "Webinaari", "catWS": "Työpaja",
    "catEvent1": "Tapahtuma", "catEvent2": "Tapahtuma",
    "yrLabel": "Suodata vuoden mukaan", "yrAll": "Kaikki vuodet",
    "aria": "Tapahtumat ja toiminta", "ariaPag": "Tulossivu",
    "colDate": "Päivämäärä", "colType": "Tyyppi", "colTitle": "Otsikko", "colDesc": "Kuvaus / Lisätiedot", "colLink": "Linkki",
