<script>
(function () {
  var searchBtn = document.querySelector('.site-search-btn');
  if (!searchBtn) return;
  function getModal() { return document.querySelector('pagefind-modal'); }
  searchBtn.addEventListener('click', function (e) {
    e.preventDefault();
    var m = getModal();
    if (m && m.open) m.open();
  });
  document.addEventListener('keydown', function (e) {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable)) return;
      e.preventDefault();
      var m = getModal();
      if (!m) return;
      m.isOpen ? m.close() : m.open();
    }
  });
}());
</script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    var PX_PER_SEC = 120;
    document.querySelectorAll('.kb-post-feed-carousel-wrap').forEach(function(wrap) {
      var track = wrap.querySelector('.kb-post-feed-carousel');
      if (!track) return;
      Array.from(track.children).forEach(function(card) {
        track.appendChild(card.cloneNode(true));
      });
      var halfWidth = track.scrollWidth / 2;
      var paused = false;
      var raf = null;
      var last = null;
      function tick(ts) {
        if (!paused) {
          if (last !== null) {
            track.scrollLeft += PX_PER_SEC * (ts - last) / 1000;
            if (track.scrollLeft >= halfWidth) track.scrollLeft -= halfWidth;
          }
          last = ts;
        } else {
          last = null;
        }
        raf = requestAnimationFrame(tick);
      }
      wrap.addEventListener('mouseenter', function() { paused = true; });
      wrap.addEventListener('mouseleave', function() { paused = false; });
      wrap.addEventListener('touchstart', function() { paused = true; }, { passive: true });
      wrap.addEventListener('touchend', function() { paused = false; }, { passive: true });
      raf = requestAnimationFrame(tick);
    });
  });
</script>
