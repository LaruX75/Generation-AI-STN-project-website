{# 1. APPS — white #}
<section class="mat-section">
  <div class="mat-section-inner">

    <div class="gen-ai-tools-intro">
      <p>The apps and learning materials developed by the Generation AI project are freely available at <a href="https://www.gen-ai.fi/en" target="_blank" rel="noopener">gen-ai.fi</a>. Over 182,000 uses in total!</p>
    </div>

    <div class="gen-ai-tool-grid">

      {% for app in sovellukset[lang] %}
      <div class="gen-ai-tool-card">
        {% if app.image %}
          <div class="gen-ai-tool-card-image"><img src="{{ app.image }}" alt="{{ app.imageAlt }}" loading="lazy"></div>
        {% else %}
          <div class="gen-ai-tool-card-image gen-ai-tool-card-image--placeholder" aria-hidden="true">⚙️</div>
        {% endif %}
        <span class="gen-ai-tool-card-type">{{ app.type }}</span>
        {% if app.status == "active" %}
          <div class="gen-ai-tool-card-header"><span class="gen-ai-tool-badge gen-ai-tool-badge--active">Available</span></div>
        {% elif app.status == "beta" %}
          <div class="gen-ai-tool-card-header"><span class="gen-ai-tool-badge gen-ai-tool-badge--beta">Beta</span></div>
        {% elif app.status == "coming" %}
          <div class="gen-ai-tool-card-header"><span class="gen-ai-tool-badge gen-ai-tool-badge--new">Coming soon</span></div>
        {% endif %}
        <h3 class="gen-ai-tool-card-title">{{ app.title }}</h3>
        <p class="gen-ai-tool-card-desc">{{ app.desc }}</p>
        <div class="gen-ai-tool-card-meta">
          {% for tag in app.tags %}<span class="gen-ai-tool-tag">{{ tag }}</span>{% endfor %}
        </div>
        <div class="gen-ai-tool-card-links">
          {% if app.aboutUrl %}
            <a class="gen-ai-tool-card-about" href="{{ app.aboutUrl }}" target="_blank" rel="noopener">Description</a>
          {% endif %}
          {% if app.status == "coming" %}
            <span class="gen-ai-tool-card-link gen-ai-tool-card-link--disabled">Coming soon</span>
          {% elif app.status == "beta" %}
            <a class="gen-ai-tool-card-link" href="{{ app.appUrl }}" target="_blank" rel="noopener">Try the beta ↗</a>
          {% else %}
            <a class="gen-ai-tool-card-link" href="{{ app.appUrl }}" target="_blank" rel="noopener">Try the app ↗</a>
          {% endif %}
          {% for lesson in app.lessons %}
            <a class="gen-ai-tool-card-curriculum" href="{{ lesson.url }}" target="_blank" rel="noopener">{{ lesson.text }}</a>
          {% endfor %}
        </div>
        {% if app.license %}
          <div class="gen-ai-tool-card-legal">
            <span class="gen-ai-tool-legal-badge">{{ app.license }}</span>
            {% if app.privacyUrl %}<a class="gen-ai-tool-legal-link" href="{{ app.privacyUrl }}" target="_blank" rel="noopener">Privacy policy</a>{% endif %}
            {% if app.githubUrl %}<a class="gen-ai-tool-legal-link" href="{{ app.githubUrl }}" target="_blank" rel="noopener">GitHub</a>{% endif %}
          </div>
        {% endif %}
      </div>
      {% endfor %}

    </div>

    <p class="mat-all-link"><a href="https://www.gen-ai.fi/en" target="_blank" rel="noopener">All materials at gen-ai.fi →</a></p>

  </div>
</section>

{# 2. TEACHING UNITS — light green #}
<section class="mat-section mat-section--alt">
  <div class="mat-section-inner">
    <h2 class="mat-section-heading">Teaching Units</h2>
    <div class="mat-curricula-grid">

      {% for unit in oppimateriaalit %}
        {% if lang in unit.lang %}
        <div class="mat-curricula-card">
          <span class="gen-ai-tool-card-type">{{ unit.typeLabel[lang] }}</span>
          <h3 class="mat-curricula-title">{{ unit.title[lang] }}</h3>
          <p class="mat-curricula-desc">{{ unit.desc[lang] }}</p>
          <div class="mat-curricula-meta">
            {% if unit.duration %}<span class="gen-ai-tool-tag">{{ unit.duration }} {{ unit.durationLabel[lang] }}</span>{% endif %}
            {% for tag in unit.appTags[lang] %}<span class="gen-ai-tool-tag">{{ tag }}</span>{% endfor %}
          </div>
          <a class="gen-ai-tool-card-link" href="{{ unit.url[lang] }}" target="_blank" rel="noopener">{{ unit.linkLabel[lang] }}</a>
        </div>
        {% endif %}
      {% endfor %}

    </div>
  </div>
</section>

{# 3. PUBLICATIONS — white #}
<section class="mat-section">
  <div class="mat-section-inner">
    <h2 class="mat-section-heading">Publications</h2>
    <div class="mat-pub-grid">

      <div class="mat-pub-card mat-pub-card--book">
        <div class="mat-pub-card-accent"></div>
        <div class="mat-pub-card-body">
          <span class="mat-pub-card-type">Non-fiction book</span>
          <h3 class="mat-pub-card-title">50 Myths about AI and Data</h3>
          <p class="mat-pub-card-desc">AI is neither magic nor doom — but it is full of myths. This book debunks 50 common misconceptions based on research evidence. Written by 30 experts from four universities, spanning computer science, law, education, sociology and philosophy.</p>
          <p class="mat-pub-card-authors">A collaboration between the Generation AI and DataLit projects</p>
          <div class="mat-pub-card-actions">
            <a class="mat-pub-card-btn mat-pub-card-btn--primary" href="https://doi.org/10.58181/VP9789523972513" target="_blank" rel="noopener">Download free (PDF) ↗</a>
            <a class="mat-pub-card-btn mat-pub-card-btn--secondary" href="https://vastapaino.fi/sivu/tuote/50-myyttia-tekoalysta-ja-datasta/5353057" target="_blank" rel="noopener">Vastapaino.fi ↗</a>
          </div>
        </div>
      </div>

      <div class="mat-pub-card mat-pub-card--case">
        <div class="mat-pub-card-accent"></div>
        <div class="mat-pub-card-body">
          <span class="mat-pub-card-type">Case study</span>
          <h3 class="mat-pub-card-title">AI as a subject of learning and a tool for creative activity</h3>
          <p class="mat-pub-card-desc">How does AI show up in children's everyday lives and at school? This case study examines AI both as a subject of learning and as a tool for creativity — with a practical focus on teachers' work.</p>
          <p class="mat-pub-card-authors">Generation AI project, 2023</p>
          <div class="mat-pub-card-actions">
            <a class="mat-pub-card-btn mat-pub-card-btn--primary" href="/media/wp-content/uploads/2024/01/GenAI_2023_Case.pdf" target="_blank" rel="noopener">Read publication (PDF) ↗</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

