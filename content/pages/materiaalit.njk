{# 1. SOVELLUKSET — valkoinen #}
<section class="mat-section">
  <div class="mat-section-inner">

    <div class="gen-ai-tools-intro">
      <p>Generation AI -projektin kehittämät sovellukset ja oppimateriaalit ovat vapaasti käytettävissä osoitteessa <a href="https://www.gen-ai.fi/fi" target="_blank" rel="noopener">gen-ai.fi</a>. Yhteensä yli 182&nbsp;000 käyttökertaa!</p>
    </div>

    <div class="gen-ai-tool-grid">

      {% for app in sovellukset[lang] %}
      <div class="gen-ai-tool-card">
        {% if app.image %}
          <div class="gen-ai-tool-card-image"><img src="{{ app.image }}" alt="{{ app.imageAlt }}" loading="lazy"></div>
        {% else %}
          <div class="gen-ai-tool-card-image gen-ai-tool-card-image--placeholder" aria-hidden="true">⚙️</div>
        {% endif %}
        <span class="gen-ai-tool-card-type">{{ app.type }}</span>
        {% if app.status == "active" %}
          <div class="gen-ai-tool-card-header"><span class="gen-ai-tool-badge gen-ai-tool-badge--active">Saatavilla</span></div>
        {% elif app.status == "beta" %}
          <div class="gen-ai-tool-card-header"><span class="gen-ai-tool-badge gen-ai-tool-badge--beta">Beta</span></div>
        {% elif app.status == "coming" %}
          <div class="gen-ai-tool-card-header"><span class="gen-ai-tool-badge gen-ai-tool-badge--new">Tulossa</span></div>
        {% endif %}
        <h3 class="gen-ai-tool-card-title">{{ app.title }}</h3>
        <p class="gen-ai-tool-card-desc">{{ app.desc }}</p>
        <div class="gen-ai-tool-card-meta">
          {% for tag in app.tags %}<span class="gen-ai-tool-tag">{{ tag }}</span>{% endfor %}
        </div>
        <div class="gen-ai-tool-card-links">
          {% if app.aboutUrl %}
            <a class="gen-ai-tool-card-about" href="{{ app.aboutUrl }}" target="_blank" rel="noopener">Kuvaus</a>
          {% endif %}
          {% if app.status == "coming" %}
            <span class="gen-ai-tool-card-link gen-ai-tool-card-link--disabled">Tulossa pian</span>
          {% elif app.status == "beta" %}
            <a class="gen-ai-tool-card-link" href="{{ app.appUrl }}" target="_blank" rel="noopener">Kokeile beetaa ↗</a>
          {% else %}
            <a class="gen-ai-tool-card-link" href="{{ app.appUrl }}" target="_blank" rel="noopener">Kokeile sovellusta ↗</a>
          {% endif %}
          {% for lesson in app.lessons %}
            <a class="gen-ai-tool-card-curriculum" href="{{ lesson.url }}" target="_blank" rel="noopener">{{ lesson.text }}</a>
          {% endfor %}
        </div>
        {% if app.license %}
          <div class="gen-ai-tool-card-legal">
            <span class="gen-ai-tool-legal-badge">{{ app.license }}</span>
            {% if app.privacyUrl %}<a class="gen-ai-tool-legal-link" href="{{ app.privacyUrl }}" target="_blank" rel="noopener">Tietosuojaseloste</a>{% endif %}
            {% if app.githubUrl %}<a class="gen-ai-tool-legal-link" href="{{ app.githubUrl }}" target="_blank" rel="noopener">GitHub</a>{% endif %}
          </div>
        {% endif %}
      </div>
      {% endfor %}

    </div>

    <p class="mat-all-link"><a href="https://www.gen-ai.fi/fi" target="_blank" rel="noopener">Kaikki materiaalit gen-ai.fi:ssä →</a></p>

  </div>
</section>

{# 2. OPETUSKOKONAISUUDET — vaaleanvihreä #}
<section class="mat-section mat-section--alt">
  <div class="mat-section-inner">
    <h2 class="mat-section-heading">Opetuskokonaisuudet</h2>
    <div class="mat-curricula-grid">

      {% for unit in oppimateriaalit %}
        {% if lang in unit.lang %}
        <div class="mat-curricula-card">
          <span class="gen-ai-tool-card-type">{{ unit.typeLabel[lang] }}</span>
          <h3 class="mat-curricula-title">{{ unit.title[lang] }}</h3>
          <p class="mat-curricula-desc">{{ unit.desc[lang] }}</p>
          <div class="mat-curricula-meta">
            {% if unit.duration %}<span class="gen-ai-tool-tag">{{ unit.duration }} {{ unit.durationLabel[lang] }}</span>{% endif %}
            {% for tag in unit.appTags[lang] %}<span class="gen-ai-tool-tag">{{ tag }}</span>{% endfor %}
          </div>
          <a class="gen-ai-tool-card-link" href="{{ unit.url[lang] }}" target="_blank" rel="noopener">{{ unit.linkLabel[lang] }}</a>
        </div>
        {% endif %}
      {% endfor %}

    </div>
  </div>
</section>

{# 3. JULKAISUT — valkoinen #}
<section class="mat-section">
  <div class="mat-section-inner">
    <h2 class="mat-section-heading">Julkaisut</h2>
    <div class="mat-pub-grid">

      <div class="mat-pub-card mat-pub-card--book">
        <div class="mat-pub-card-accent"></div>
        <div class="mat-pub-card-body">
          <span class="mat-pub-card-type">Tietokirja</span>
          <h3 class="mat-pub-card-title">50 myyttiä tekoälystä ja datasta</h3>
          <p class="mat-pub-card-desc">Tekoäly ei ole taikaa eikä tuho — mutta se on täynnä myyttejä. Tämä tietokirja murtaa 50 yleistä väärinkäsitystä tutkimustietoon nojaten. Kirjoittajina 30 asiantuntijaa neljästä yliopistosta: tietojenkäsittelytieteen, oikeustieteen, kasvatustieteen, sosiologian ja filosofian aloilta.</p>
          <p class="mat-pub-card-authors">Generation AI- ja DataLit-hankkeiden yhteistyö</p>
          <div class="mat-pub-card-actions">
            <a class="mat-pub-card-btn mat-pub-card-btn--primary" href="https://doi.org/10.58181/VP9789523972513" target="_blank" rel="noopener">Lataa ilmaiseksi (PDF) ↗</a>
            <a class="mat-pub-card-btn mat-pub-card-btn--secondary" href="https://vastapaino.fi/sivu/tuote/50-myyttia-tekoalysta-ja-datasta/5353057" target="_blank" rel="noopener">Vastapaino.fi ↗</a>
          </div>
        </div>
      </div>

      <div class="mat-pub-card mat-pub-card--guide">
        <div class="mat-pub-card-accent"></div>
        <div class="mat-pub-card-body">
          <span class="mat-pub-card-type">Opas</span>
          <h3 class="mat-pub-card-title">Henkilötietojen käsittely alakoulussa</h3>
          <p class="mat-pub-card-desc">Katsaus GDPR-sääntelyn soveltamiseen alakouluissa, erityisesti kolmannen osapuolen sovellusten käytössä. Käy läpi rekisterinpitäjän vastuun, käsittelyperusteet ja lasten erityisen suojan — käytännön esimerkkein.</p>
          <p class="mat-pub-card-authors">Susanna Lindroos-Hovinheimo &amp; Eveliina Ignatius</p>
          <div class="mat-pub-card-actions">
            <a class="mat-pub-card-btn mat-pub-card-btn--primary" href="/henkilotietojen-kasittely-alakoulussa/">Lue opas →</a>
          </div>
        </div>
      </div>

      <div class="mat-pub-card mat-pub-card--case">
        <div class="mat-pub-card-accent"></div>
        <div class="mat-pub-card-body">
          <span class="mat-pub-card-type">Tapaustutkimus</span>
          <h3 class="mat-pub-card-title">Tekoäly oppimisen kohteena ja luovan toiminnan välineenä</h3>
          <p class="mat-pub-card-desc">Miten tekoäly näkyy lasten arjessa ja koulussa? Tapaustutkimus tarkastelee tekoälyä sekä oppimisen kohteena että luovuuden apuvälineenä — käytännönläheisesti ja opettajien työn näkökulmasta.</p>
          <p class="mat-pub-card-authors">Generation AI -hanke, 2023</p>
          <div class="mat-pub-card-actions">
            <a class="mat-pub-card-btn mat-pub-card-btn--primary" href="/media/wp-content/uploads/2024/01/GenAI_2023_Case.pdf" target="_blank" rel="noopener">Lue julkaisu (PDF) ↗</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

