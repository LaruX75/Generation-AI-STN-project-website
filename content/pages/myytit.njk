<div data-pagefind-body>
<section class="mat-section">
  <div class="mat-section-inner mat-section-inner--narrow">

    <div class="myytit-intro">
      <p class="myytit-intro-lead"><em>50 myyttiä tekoälystä ja datasta</em> on avoin tietokirja, joka murtaa yleisiä väärinkäsityksiä tekoälystä ja datasta tutkimustietoon nojaten. Kirjoittajina 30 asiantuntijaa neljästä yliopistosta.</p>
      <p class="myytit-intro-license">Kirja on lisensoitu <a href="https://creativecommons.org/licenses/by-nc-nd/4.0/deed.fi" target="_blank" rel="noopener">CC BY-NC-ND 4.0</a> -käyttöluvalla. Luvut julkaistaan täällä muuttamattomina; muoto on muunnettu verkkojulkaisua varten.</p>
      <div class="myytit-intro-actions">
        <a class="myytit-intro-btn myytit-intro-btn--primary" href="https://doi.org/10.58181/VP9789523972513" target="_blank" rel="noopener">Lataa kirja ilmaiseksi (PDF) ↗</a>
        <a class="myytit-intro-btn myytit-intro-btn--secondary" href="{{ myyttipodcast.kaudet[0].spotifyUrl }}" target="_blank" rel="noopener">Podcast Spotifyssa ↗</a>
      </div>
    </div>

    {% for luku in myytit.luvut %}
    <section class="myytit-chapter-group">
      <h2 class="myytit-chapter-heading">{{ luku.otsikko }}</h2>
      <ul class="myytit-list">
        {% for m in luku.myytit %}
          {% set publishedPage = null %}
          {% for p in collections.myytit %}
            {% if p.data.numero == m.nro %}{% set publishedPage = p %}{% endif %}
          {% endfor %}
          <li class="myytit-item{% if publishedPage %} myytit-item--published{% endif %}">
            <span class="myytit-item-num">{{ m.nro }}</span>
            {% if publishedPage %}
              <a class="myytit-item-link" href="{{ publishedPage.url }}">{{ m.otsikko }}</a>
            {% else %}
              <span class="myytit-item-title">{{ m.otsikko }}</span>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </section>
    {% endfor %}

  </div>
</section>
</div>
