{# ── 4. Sovellukset ja materiaalit ───────────────────────────────────────── #}
<section class="teacher-tools" id="sovellukset">
  <div class="teacher-tools-inner">
    <h2 class="teacher-tools-heading">Sovellukset ja materiaalit luokkahuoneeseen</h2>
    <p class="teacher-tools-lead">Maksuttomia, selainpohjaisia tekoälysovelluksia esi- ja perusopetukseen – ei rekisteröitymistä.</p>

    <div class="teacher-tools-grid">
      {% for app in sovellukset[lang] %}
      <div class="teacher-tool-card">
        {% if app.status == "coming" %}
          <div class="teacher-tool-status"><span class="gen-ai-tool-badge gen-ai-tool-badge--new">Tulossa</span></div>
        {% elif app.status == "beta" %}
          <div class="teacher-tool-status"><span class="gen-ai-tool-badge gen-ai-tool-badge--beta">Beta</span></div>
        {% endif %}
        <h3 class="teacher-tool-name">{{ app.title }}</h3>
        <div class="teacher-tool-tags">
          {% for tag in app.tags %}<span class="gen-ai-tool-tag">{{ tag }}</span>{% endfor %}
        </div>
        <p class="teacher-tool-desc">{{ app.teacherDesc }}</p>
        {% if app.status == "coming" %}
          <span class="teacher-tool-link teacher-tool-link--disabled">Tulossa pian</span>
        {% elif app.appUrl %}
          <a class="teacher-tool-link" href="{{ app.appUrl }}" target="_blank" rel="noopener">Avaa sovellus ↗</a>
        {% endif %}
        {% for lesson in app.lessons %}
          <a class="teacher-tool-lesson" href="{{ lesson.url }}" target="_blank" rel="noopener">Oppitunnit →</a>
        {% endfor %}
      </div>
      {% endfor %}
    </div>

    <div class="teacher-tools-cta">
      <a class="teacher-tools-all-btn" href="/materiaalit/">Kaikki sovellukset ja materiaalit →</a>
    </div>
  </div>
</section>

{# ── 5. Oppaat ja julkaisut ──────────────────────────────────────────────── #}
<section class="teacher-guide">
