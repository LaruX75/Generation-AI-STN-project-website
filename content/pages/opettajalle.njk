    <h2 class="teacher-tools-heading">Sovellukset luokkahuoneeseen</h2>
    <p class="teacher-tools-lead">Maksuttomia, selainpohjaisia tekoälysovelluksia esi- ja perusopetukseen — ei asennuksia, ei rekisteröitymistä.</p>

    <div class="teacher-tools-grid">
      {% for app in sovellukset[lang] %}
        {% if app.featured %}
        <div class="teacher-tool-card">
          <h3 class="teacher-tool-name">{{ app.title }}</h3>
          <div class="teacher-tool-tags">
            {% for tag in app.tags %}<span class="gen-ai-tool-tag">{{ tag }}</span>{% endfor %}
          </div>
          <p class="teacher-tool-desc">{{ app.teacherDesc }}</p>
          {% if app.appUrl %}
            <a class="teacher-tool-link" href="{{ app.appUrl }}" target="_blank" rel="noopener">Avaa sovellus ↗</a>
          {% endif %}
          {% for lesson in app.lessons %}
            <a class="teacher-tool-lesson" href="{{ lesson.url }}" target="_blank" rel="noopener">Oppitunnit →</a>
          {% endfor %}
        </div>
        {% endif %}
